# Copy to .env (git-ignored) and adjust before running `docker compose up`.
# Every value has a default in docker-compose.yml, but the defaults are for
# throwaway local use, not for anything reachable from a network.

# --- MongoDB ---------------------------------------------------------------
# Used only by the local mongo container. Ignored as soon as MONGODB_URI is set.
MONGO_ROOT_USER=quiz
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string
MONGO_DB=quiz
# Loopback-only by default; the app talks to mongo over the compose network.
MONGO_BIND=127.0.0.1
MONGO_PORT=27017

# Use a hosted MongoDB instead of the local container (see the README). Leave
# this unset to keep using the container. Encode the password: @ -> %40, : -> %3A.
# Hosted providers hand you a mongodb+srv:// string. The local container cannot
# use +srv - a single node publishes no _mongodb._tcp SRV record - so local work
# keeps the mongodb://...@mongo:27017/quiz form the compose file builds.
# MONGODB_URI=mongodb+srv://user:password@cluster0.abcde.mongodb.net/quiz?retryWrites=true&w=majority

# --- Web -------------------------------------------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Token that unlocks /builder and every admin GraphQL operation.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=change-me-too

# --- Build args ------------------------------------------------------------
# Host user the dev container runs as, so bind-mounted files stay writable.
# Find yours with: id -u && id -g
HOST_UID=1000
HOST_GID=1000
